# ============================================================
# OSU FUTMinna — environment variables (no real secrets here)
# Copy this file to .env and fill in real values. NEVER commit .env
# ============================================================

# The web address the site is served from (used to build invite links).
# In local development this stays empty and the app works it out.
PUBLIC_URL=

# ------------------------------------------------------------
# API server
# ------------------------------------------------------------
PORT=4000

# Secret used to sign session cookies. MUST be a long random string in
# production — generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In local development a default is used automatically, but set one here
# if you want a persistent secret across restarts.
JWT_SECRET=

# Cookie security. Keep false during local development (http).
# Set to true in production (https).
COOKIE_SECURE=false

# ------------------------------------------------------------
# First administrator (created by `npm run seed:admin`)
# ------------------------------------------------------------
ADMIN_NAME=OSU Administrator
ADMIN_EMAIL=admin@osu.local
# Leave empty and the seed script will generate a strong random password
# and print it ONCE to your terminal.
ADMIN_PASSWORD=
